SECRET_KEY=change-me-for-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Leave POSTGRES_* unset for local SQLite usage outside Docker.
POSTGRES_DB=tickets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Use "db" when running with docker compose, "localhost" for local non-docker runs.
POSTGRES_HOST=db
POSTGRES_PORT=5432
OPENAI_PROXY_BASE_URL=http://host.docker.internal:11435/v1
OPENAI_PROXY_MODEL=freeloader
